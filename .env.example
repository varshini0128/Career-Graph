# CognoDB Bolt connection — never commit real credentials
COGNODB_URI=bolt://your-cognodb-host:7687
COGNODB_USERNAME=your-username
COGNODB_PASSWORD=your-password
# Optional database name (defaults to neo4j)
COGNODB_DATABASE=neo4j

# Optional: frontend URL for a deployed backend
# VITE_API_URL=http://localhost:8000
